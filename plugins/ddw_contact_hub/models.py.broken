from __future__ import annotations
"""DDW 联系人管理插件 ORM 模型。

继承 DDW 平台核心：
- core.database.session.Base: DeclarativeBase 根
- core.database.models.TenantMixin: 自动注入 tenant_id + 标记租户感知
- core.database.models.TimestampMixin: 自动注入 created_at / updated_at
"""

from typing import Optional

from sqlalchemy import JSON, BigInteger, Boolean, ForeignKey, Integer, String, Text
from sqlalchemy.orm import Mapped, mapped_column

from core.database.models import Base, TenantMixin, TimestampMixin

# BigInteger 在 SQLite 不支持 -> 退化到 Integer
BigInt = BigInteger().with_variant(Integer(), "sqlite")


class Contact(Base, TenantMixin, TimestampMixin):
    """联系人主表。

    设计要点：
    - ``company_id`` 可空：允许独立联系人（无所属企业）
    - 外键 ``crm_companies.id`` ON DELETE SET NULL：企业被删/归档后联系人保留
    - ``tags`` / ``groups`` 用 JSON 列表，便于灵活打标
    - ``is_primary`` 标识主联系人（一企业通常 1 个主联系人，可多设）
    """

    __tablename__ = "crm_contacts"
    __table_args__ = {"extend_existing": True}

    id: Mapped[int] = mapped_column(BigInt, primary_key=True, autoincrement=True)

    # ---- 关联 ----
    company_id: Mapped[Optional[int]] = mapped_column(        BigInt,
        ForeignKey("crm_companies.id", ondelete="SET NULL"),
        nullable=True,
        index=True,

    # ---- 基本信息 ----
    name: Mapped[str] = mapped_column(String(50), nullable=False, index=True)
    phone: Mapped[Optional[str]] = mapped_column(String(20), nullable=True)
    email: Mapped[Optional[str]] = mapped_column(String(100), nullable=True)
    position: Mapped[Optional[str]] = mapped_column(String(50), nullable=True)
    department: Mapped[Optional[str]] = mapped_column(String(50), nullable=True)
    wechat: Mapped[Optional[str]] = mapped_column(String(50), nullable=True)
    # ---- 扩展 ----
    tags: Mapped[Optional[list]] = mapped_column(JSON, default=list)
    groups: Mapped[Optional[list]] = mapped_column(JSON, default=list)
    is_primary: Mapped[bool] = mapped_column(Boolean, default=False)
    notes: Mapped[Optional[str]] = mapped_column(# ---- 状态 ---- status: Mapped[Optional[str]] = mapped_column(        String(20), default="active", nullable=False, index=True ) # active/inactive/archived  # ---- 审计 ---- created_by: Mapped[Optional[int]] = mapped_column(BigInt, nullable=True)  def __repr__(self) -> str:  # pragma: no cover return f"<Contact id={self.id} name={self.name!r}>"   __all__ = ["Contact"])
