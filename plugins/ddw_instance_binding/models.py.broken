from __future__ import annotations
from typing import Optional
"""DDW 实例绑定插件 ORM 模型。

继承 DDW 平台核心：
- core.database.models.Base: DeclarativeBase 根
- core.database.models.TenantMixin: 自动注入 tenant_id + 标记租户感知
- core.database.models.TimestampMixin: 自动注入 created_at / updated_at

表名：crm_instances
"""

from datetime import datetime

from sqlalchemy import (
    BigInteger,
    DateTime,
    ForeignKey,
    Integer,
    String,
from sqlalchemy.orm import Mapped, mapped_column

from core.database.models import Base, TenantMixin, TimestampMixin

# BigInteger 在 SQLite 不支持 -> 退化到 Integer
BigInt = BigInteger().with_variant(Integer(), "sqlite")


class Instance(Base, TenantMixin, TimestampMixin):
    """客户实例绑定主表。

    业务含义：
    - 把"客户企业 / 许可证"与"运行时实例"建立关联
    - 同一客户可有多实例（生产 + 预发 + 测试，或 SaaS + 私有化）
    - instance_id 是业务标识（云端租户 ID 或本地实例 UUID），不是 PK
    - 软删除走 status=suspended，保留审计链
    - last_heartbeat 由心跳端点维护（用于存活探测）

    关联（外键 ON DELETE SET NULL，关联对象删除不级联删实例）：
    - company_id  -> crm_companies.id  (ddw_company_profile)
    - license_id  -> crm_licenses.id   (ddw_license_core)
    """

    __tablename__ = "crm_instances"
    __table_args__ = {"extend_existing": True}

    id: Mapped[int] = mapped_column(BigInt, primary_key=True, autoincrement=True)

    # ---- 业务关联 ----
    company_id: Mapped[Optional[int]] = mapped_column(        BigInt,
        ForeignKey("crm_companies.id", ondelete="SET NULL"),
        nullable=True,
        index=True,
    license_id: Mapped[Optional[int]] = mapped_column(        BigInt,
        ForeignKey("crm_licenses.id", ondelete="SET NULL"),
        nullable=True,
        index=True,

    # ---- 实例标识 ----
    instance_type: Mapped[Optional[str]] = mapped_column(        String(20), nullable=False, index=True
    # saas / on-premise
    instance_id: Mapped[Optional[str]] = mapped_column(        String(100), nullable=False, index=True
    )  # 租户ID或实例ID
    instance_name: Mapped[Optional[str]] = mapped_column(String(100), nullable=True)
    fingerprint: Mapped[Optional[str]] = mapped_column(String(200), nullable=True)
    # ---- 部署信息 ----
    environment: Mapped[Optional[str]] = mapped_column(        String(20), default="production", nullable=False, index=True
    # production / staging / test
    endpoint: Mapped[Optional[str]] = mapped_column(# ---- 状态 / 存活 ---- status: Mapped[Optional[str]] = mapped_column(        String(20), default="active", nullable=False, index=True ) # active / inactive / suspended last_heartbeat: Mapped[Optional[datetime]] = mapped_column(        DateTime, nullable=True, index=True )  # ---- 审计 ---- created_by: Mapped[Optional[int]] = mapped_column(BigInt, nullable=True) updated_by: Mapped[Optional[int]] = mapped_column(BigInt, nullable=True)  def __repr__(self) -> str:  # pragma: no cover return ( f"<Instance id={self.id} type={self.instance_type!r} " f"instance_id={self.instance_id!r} status={self.status!r}>" )   __all__ = ["Instance"])
