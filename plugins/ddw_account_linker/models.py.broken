from __future__ import annotations
from typing import Optional
"""DDW 账号/租户/实例映射插件 ORM 模型。

继承 DDW 平台核心：
- core.database.session.Base: DeclarativeBase 根
- core.database.models.TenantMixin: 自动注入 tenant_id + 标记租户感知
- core.database.models.TimestampMixin: 自动注入 created_at / updated_at
"""

from sqlalchemy import JSON, BigInteger, ForeignKey, Integer, String, UniqueConstraint
from sqlalchemy.orm import Mapped, mapped_column

from core.database.models import Base, TenantMixin, TimestampMixin

# BigInteger 在 SQLite 不支持 -> 退化到 Integer
BigInt = BigInteger().with_variant(Integer(), "sqlite")


class AccountLink(Base, TenantMixin, TimestampMixin):
    """账号/租户/实例映射主表。

    设计要点：
    - ``company_id`` 可空：允许独立的账号链接（尚未关联到任何企业）
    - 外键 ``crm_companies.id`` ON DELETE SET NULL：企业被删/归档后链接保留
    - ``link_type`` 三种：user / saas_tenant / on_premise_instance
    - ``external_id`` 在 ``(tenant_id, link_type)`` 范围内唯一
    - ``metadata_json`` 存额外上下文（实例规格、租户 region 等）
    """

    __tablename__ = "crm_account_links"
    __table_args__ = (
        UniqueConstraint("tenant_id", "link_type", "external_id", name="uq_account_link_tenant_type_extid"),
        {"extend_existing": True},

    id: Mapped[int] = mapped_column(BigInt, primary_key=True, autoincrement=True)

    # ---- 关联（可空：允许未挂靠企业的独立链接） ----
    company_id: Mapped[Optional[int]] = mapped_column(        BigInt,
        ForeignKey("crm_companies.id", ondelete="SET NULL"),
        nullable=True,
        index=True,

    # ---- 分类 ----
    link_type: Mapped[Optional[str]] = mapped_column(        String(20), nullable=False, index=True
    # user / saas_tenant / on_premise_instance
    external_id: Mapped[Optional[str]] = mapped_column(        String(100), nullable=False, index=True
    external_name: Mapped[Optional[str]] = mapped_column(# ---- 扩展 ---- metadata_json: Mapped[Optional[dict]] = mapped_column(JSON, default=dict)  # ---- 状态 ---- status: Mapped[Optional[str]] = mapped_column(        String(20), default="active", nullable=False, index=True ) # active / inactive  # ---- 审计 ---- created_by: Mapped[Optional[int]] = mapped_column(BigInt, nullable=True)  def __repr__(self) -> str:  # pragma: no cover return f"<AccountLink id={self.id} type={self.link_type!r} ext_id={self.external_id!r}>"   __all__ = ["AccountLink"])
