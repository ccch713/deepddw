# deepDDW 0.1 部署配置模板（可选；不提供则使用 core/config.py 内置默认值）
# 复制为 config/deployment.yaml 并按需修改（deployment.yaml 已被 .gitignore 忽略）

mode: standalone
deployment:
  # R4-0（DSH for Teams）：部署模式 solo|family|team（env DDW_DEPLOYMENT_MODE）
  # solo=单人多设备（默认，v0.3.0 行为）；family=家庭共享；team=团队多用户
  # mode: solo

server:
  host: 0.0.0.0
  port: 8500
  workers: 1

databases:
  main:
    engine: sqlite
    path: ./data/ddw_main.db

llm_gateway:
  default_provider: deepseek
  providers:
    deepseek:
      base_url: https://api.deepseek.com/v1
      api_key: "${DDW_DEEPSEEK_API_KEY}"
      default_model: deepseek-chat
    ollama:
      base_url: http://localhost:11434
      default_model: qwen2.5:7b

auth:
  # 静态访问 Token：强烈建议用环境变量 DDW_ACCESS_TOKEN（本模板占位符不生效）
  # access_token: ""

security:
  # P0-4：局域网免密默认关闭；需要时显式开启
  lan_bypass: false
  # 可信反代白名单（IP/CIDR）：仅直连 peer 在此列表才信任 X-Forwarded-For
  trusted_proxies: []

  # P0-2（multidevice）：网关限流（滑动窗口，内存实现，零新依赖）
  # env 覆盖：DDW_RATE_LIMIT_PER_TOKEN / PER_IP / GLOBAL / ENABLED
  rate_limit:
    enabled: true
    per_token: 60        # req/min/token（20 设备场景可放宽到 120+）
    per_ip: 120          # req/min/ip
    global: 300          # req/min 全网关总容量（超过 → 503 过载保护）
    window_seconds: 60

  # P1-2（multidevice）：可选 TLS（默认关闭；启用需先生成证书）
  # 生成: ./scripts/gen_self_signed_cert.sh data/tls localhost
  # env 覆盖: DDW_TLS_ENABLED / DDW_TLS_CERT / DDW_TLS_KEY / DDW_TLS_PORT
  tls:
    enabled: false
    cert_file: ./data/tls/cert.pem
    key_file: ./data/tls/key.pem
    port: 0             # 0 = 沿用主端口（HTTP 同端口升级为 HTTPS）

plugins:
  root_dir: ./plugins
