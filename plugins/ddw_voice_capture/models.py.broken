from __future__ import annotations
from typing import Optional
"""DDW 录音与语音输入插件 ORM 模型。

继承 DDW 平台核心：
- core.database.session.Base: DeclarativeBase 根
- core.database.models.TenantMixin: 自动注入 tenant_id + 标记租户感知
- core.database.models.TimestampMixin: 自动注入 created_at / updated_at

设计要点：
- ``file_url`` 必填，文件本身由对象存储承载，本表只存 URL + 元数据
- ``file_size``（字节）与 ``duration_seconds``（秒）必填，便于后续转写/归档时无需访问文件
- 外键 ``company_id / contact_id / opportunity_id`` 全部 ON DELETE SET NULL：
  关联对象被删/归档时录音记录仍保留（录音属于历史资产）
- ``status`` 状态机：uploaded（默认）→ transcribed → processed / failed
  ``transcribed / processed`` 由 P3-3 ddw_voice_transcribe 写入；本插件可写
  ``uploaded`` 与 ``failed``（软删除用 failed）
- 无 ``updated_at`` 不可修改语义：本表只继承 TimestampMixin 的 ``created_at`` 表示上传时间
"""

from sqlalchemy import BigInteger, ForeignKey, Integer, String, Text
from sqlalchemy.orm import Mapped, mapped_column

from core.database.models import Base, TenantMixin, TimestampMixin

# BigInteger 在 SQLite 不支持 -> 退化到 Integer
BigInt = BigInteger().with_variant(Integer(), "sqlite")


class VoiceRecord(Base, TenantMixin, TimestampMixin):
    """录音与语音输入主表。

    字段：
    - file_url: 录音文件 URL（必填，CDN / OSS / 本地路径均可）
    - file_size: 文件字节数（必填）
    - duration_seconds: 录音时长，秒（必填）
    - source_type: 录音来源，local / phone / meeting / memo
    - status: 状态，uploaded（默认）/ transcribed / processed / failed
    - 外键：company_id / contact_id / opportunity_id（皆可空、SET NULL）
    """

    __tablename__ = "crm_voice_records"
    __table_args__ = {"extend_existing": True}

    id: Mapped[int] = mapped_column(BigInt, primary_key=True, autoincrement=True)

    # ---- 上传人 / 创建人 ----
    user_id: Mapped[Optional[int]] = mapped_column(    # 上传该录音的销售/用户 ID（无外键约束，因为 users 表由 RBAC 插件管理）

    # ---- 业务关联（外键 ON DELETE SET NULL：关联对象删除不级联删录音） ----
    company_id: Mapped[Optional[int]] = mapped_column(        BigInt,
        ForeignKey("crm_companies.id", ondelete="SET NULL"),
        nullable=True,
        index=True,
    contact_id: Mapped[Optional[int]] = mapped_column(        BigInt,
        ForeignKey("crm_contacts.id", ondelete="SET NULL"),
        nullable=True,
        index=True,
    opportunity_id: Mapped[Optional[int]] = mapped_column(        BigInt,
        ForeignKey("crm_opportunities.id", ondelete="SET NULL"),
        nullable=True,
        index=True,

    # ---- 文件元数据 ----
    file_url: Mapped[Optional[str]] = mapped_column(    # 注意：原任务字段定义 Mapped[str]，但业务上 file_url 必填；
    # 必填约束在 service 层 + Pydantic schema 层保证，DB 层保留 Optional 以兼容
    # 历史数据迁移场景（DDL 不轻易改）。
    file_size: Mapped[Optional[int]] = mapped_column(Integer, nullable=False)
    duration_seconds: Mapped[Optional[int]] = mapped_column(Integer, nullable=False)
    # ---- 来源 / 状态 / 备注 ----
    source_type: Mapped[Optional[str]] = mapped_column(    # local / phone / meeting / memo
    notes: Mapped[Optional[str]] = mapped_column(Text, nullable=True)
    status: Mapped[Optional[str]] = mapped_column(String(255), nullable=True)
    # uploaded / transcribed / processed / failed

    # ---- 审计 ----
    created_by: Mapped[Optional[int]] = mapped_column(BigInt, nullable=True)

    def __repr__(self) -> str:  # pragma: no cover
        return (
            f"<VoiceRecord id={self.id} source_type={self.source_type!r} "
            f"status={self.status!r} duration={self.duration_seconds}s>"


__all__ = ["VoiceRecord"]
