# deepDDW 0.1 部署环境变量模板
# 复制为 .env 并填写真实值（.env 已被 .gitignore 忽略，绝不入库）

# ---- 网关访问 Token（P0-1 门禁，必填；缺失时使用开发默认值并告警） ----
DDW_ACCESS_TOKEN=change-me-to-a-long-random-token

# ---- LLM（可选；不配置则对话降级提示，不影响其它功能） ----
# DeepSeek 云端
DDW_DEEPSEEK_API_KEY=
# 或本机 Ollama（http://localhost:11434，无需 Key）

# ---- 服务 ----
DDW_LOG_LEVEL=INFO
DDW_ENV=development        # production 时建议收紧
DDW_CORS_EXTRA_ORIGINS=    # 逗号分隔的额外 CORS 来源
# 局域网免密（P0-4 默认关）：内网访问免 Token；公网部署保持关闭
DDW_LAN_BYPASS=0
# 可信反代白名单（IP/CIDR，逗号分隔）：仅直连 peer 在此列表才信任 X-Forwarded-For
DDW_TRUSTED_PROXIES=

# ---- SearXNG 聚合搜索（可选独立服务，默认 http://127.0.0.1:8888） ----
SEARXNG_URL=http://127.0.0.1:8888

# ---- 组织连接插件（bindcode-v1，默认关闭；详见 plugins/ddw_org_relay/README.md） ----
DDW_ORG_RELAY_ENABLED=0
DDW_ORG_RELAY_PRODUCT_TOKENS=      # 逗号分隔的产品令牌（开启后必填）
DDW_ORG_RELAY_SERVER_BASE_URL=     # 本实例 LLM 端点 base（公网部署显式配置）
