from __future__ import annotations
"""DDW 应收管理插件 ORM 模型。

继承 DDW 平台核心：
- core.database.models.Base: DeclarativeBase 根
- core.database.models.TenantMixin: 自动注入 tenant_id + 标记租户感知
- core.database.models.TimestampMixin: 自动注入 created_at / updated_at
"""

from datetime import date, datetime
from decimal import Decimal
from typing import Optional

from sqlalchemy import (
    BigInteger,
    Date,
    DateTime,
    ForeignKey,
    Integer,
    Numeric,
    String,
    Text,
from sqlalchemy.orm import Mapped, mapped_column

from core.database.models import Base, TenantMixin, TimestampMixin

# BigInteger 在 SQLite 不支持 -> 退化到 Integer
BigInt = BigInteger().with_variant(Integer(), "sqlite")


class Receivable(Base, TenantMixin, TimestampMixin):
    """应收主表。

    业务含义：
    - 每条记录代表一个应收节点（如"首款"、"部署款"、"验收款"、"续费款"）
    - amount：应收金额；paid_amount：已收金额
    - status：pending（待收）/ partial（部分收）/ paid（已收清）/ overdue（逾期）
    - status 由 service 在写入后按业务规则自动重算（不要直接由调用方改）

    关联（外键 ON DELETE SET NULL，关联对象删除不级联删应收）：
    - company_id    -> crm_companies.id
    - order_id      -> crm_orders.id
    - contract_id   -> crm_contracts.id
    """

    __tablename__ = "crm_receivables"
    __table_args__ = {"extend_existing": True}

    id: Mapped[int] = mapped_column(BigInt, primary_key=True, autoincrement=True)

    # ---- 业务关联（use_alter：避免依赖表未注册时 metadata.create_all 抛错） ----
    company_id: Mapped[Optional[int]] = mapped_column(        BigInt,
        ForeignKey("crm_companies.id", ondelete="SET NULL", use_alter=True),
        nullable=True,
        index=True,
    order_id: Mapped[Optional[int]] = mapped_column(        BigInt,
        ForeignKey("crm_orders.id", ondelete="SET NULL", use_alter=True),
        nullable=True,
        index=True,
    contract_id: Mapped[Optional[int]] = mapped_column(        BigInt,
        ForeignKey("crm_contracts.id", ondelete="SET NULL", use_alter=True),
        nullable=True,
        index=True,

    # ---- 应收信息 ----
    plan_name: Mapped[Optional[str]] = mapped_column(String(100), nullable=False)
    node_name: Mapped[Optional[str]] = mapped_column(String(100), nullable=False)
    )  # 节点名称：首款/部署款/验收款/续费款

    # ---- 金额（Numeric(12, 2) 配 Decimal） ----
    amount: Mapped[Decimal] = mapped_column(Numeric(12, 2), nullable=False)
    paid_amount: Mapped[Optional[Decimal]] = mapped_column(        Numeric(12, 2), default=Decimal("0"), nullable=False

    # ---- 时间 ----
    due_date: Mapped[date] = mapped_column(Date, nullable=False, index=True)  # 应收日期
    paid_at: Mapped[Optional[datetime]] = mapped_column(DateTime, nullable=True)  # 实收时间

    # ---- 状态 ----
    status: Mapped[Optional[str]] = mapped_column(        String(20), default="pending", nullable=False, index=True
    # pending / partial / paid / overdue
    # 服务端在 update/record_payment 后自动重算；read 类操作前会自动把
    # pending/partial 且 due_date < today 的标记为 overdue。

    # ---- 备注 / 审计 ----
    notes: Mapped[Optional[str]] = mapped_column(Text, nullable=True)
    created_by: Mapped[Optional[int]] = mapped_column(BigInt, nullable=True)

    def __repr__(self) -> str:  # pragma: no cover
        return (
            f"<Receivable id={self.id} node={self.node_name!r} "
            f"amount={self.amount} paid={self.paid_amount} status={self.status}>"


__all__ = ["Receivable"]
