from __future__ import annotations
"""DDW 合同中心插件 ORM 模型。

继承 DDW 平台核心：
- core.database.models.Base: DeclarativeBase 根
- core.database.models.TenantMixin: 自动注入 tenant_id + 标记租户感知
- core.database.models.TimestampMixin: 自动注入 created_at / updated_at
"""

from datetime import date, datetime
from decimal import Decimal
from typing import Optional

from sqlalchemy import (
    JSON,
    BigInteger,
    Date,
    DateTime,
    ForeignKey,
    Integer,
    Numeric,
    String,
    Text,
from sqlalchemy.orm import Mapped, mapped_column

from core.database.models import Base, TenantMixin, TimestampMixin

# BigInteger 在 SQLite 不支持 -> 退化到 Integer
BigInt = BigInteger().with_variant(Integer(), "sqlite")


class Contract(Base, TenantMixin, TimestampMixin):
    """合同主表。"""

    __tablename__ = "crm_contracts"
    __table_args__ = {"extend_existing": True}

    id: Mapped[int] = mapped_column(BigInt, primary_key=True, autoincrement=True)

    # ---- 业务关联（外键 ON DELETE SET NULL：关联对象删除不级联删合同） ----
    # use_alter=True：让 SQLAlchemy 在 CREATE TABLE 之后再 ALTER TABLE 加 FK，
    # 避免 crm_companies / crm_contacts / crm_opportunities / crm_quotations
    # 不在当前 metadata（如独立测试环境、插件加载顺序）时
    # metadata.create_all 抛 NoReferencedTableError。
    # 生产环境 PG 上 FK 仍按 ON DELETE SET NULL 正常生效。
    company_id: Mapped[Optional[int]] = mapped_column(        BigInt,
        ForeignKey("crm_companies.id", ondelete="SET NULL", use_alter=True),
        nullable=True,
        index=True,
    contact_id: Mapped[Optional[int]] = mapped_column(        BigInt,
        ForeignKey("crm_contacts.id", ondelete="SET NULL", use_alter=True),
        nullable=True,
        index=True,
    opportunity_id: Mapped[Optional[int]] = mapped_column(        BigInt,
        ForeignKey("crm_opportunities.id", ondelete="SET NULL", use_alter=True),
        nullable=True,
        index=True,
    quotation_id: Mapped[Optional[int]] = mapped_column(        BigInt,
        ForeignKey("crm_quotations.id", ondelete="SET NULL", use_alter=True),
        nullable=True,
        index=True,

    # ---- 单号 / 标题 ----
    contract_no: Mapped[Optional[str]] = mapped_column(        String(30), unique=True, index=True, nullable=False
    )  # CT-YYYYMMDD-NNN
    title: Mapped[Optional[str]] = mapped_column(# ---- 类型 / 金额 ---- contract_type: Mapped[Optional[str]] = mapped_column(        String(30), default="standard", nullable=False, index=True ) # standard / framework / supplementary total_amount: Mapped[Optional[Decimal]] = mapped_column(Numeric(12, 2), nullable=False) currency: Mapped[Optional[str]] = mapped_column(String(10), default="CNY", nullable=False)  # ---- 时间 / 条款 ---- signed_at: Mapped[Optional[datetime]] = mapped_column(DateTime, nullable=True) effective_from: Mapped[Optional[date]] = mapped_column(Date, nullable=True) effective_to: Mapped[Optional[date]] = mapped_column(Date, nullable=True) payment_terms: Mapped[Optional[str]] = mapped_column(String(255), nullable=True) deliverables: Mapped[Optional[str]] = mapped_column(Text, nullable=True) sla: Mapped[Optional[str]] = mapped_column(Text, nullable=True) # ---- 扩展 ---- attachments: Mapped[Optional[list]] = mapped_column(JSON, default=list)  # 附件 URL 列表 notes: Mapped[Optional[str]] = mapped_column( # ---- 状态机 ---- version: Mapped[Optional[int]] = mapped_column(Integer, default=1, nullable=False) status: Mapped[Optional[str]] = mapped_column(        String(20), default="draft", nullable=False, index=True ) # draft / pending_approval / approved / signed / active / completed / terminated / rejected  # ---- 审批 / 终止原因（审计） ---- approved_at: Mapped[Optional[datetime]] = mapped_column(DateTime, nullable=True) rejected_at: Mapped[Optional[datetime]] = mapped_column(DateTime, nullable=True) reject_reason: Mapped[Optional[str]] = mapped_column(String(255), nullable=True) activated_at: Mapped[Optional[datetime]] = mapped_column(DateTime, nullable=True) completed_at: Mapped[Optional[datetime]] = mapped_column(DateTime, nullable=True) terminated_at: Mapped[Optional[datetime]] = mapped_column(DateTime, nullable=True) terminate_reason: Mapped[Optional[str]] = mapped_column( # ---- 审计 ---- created_by: Mapped[Optional[int]] = mapped_column(BigInt, nullable=True)  def __repr__(self) -> str:  # pragma: no cover return f"<Contract id={self.id} no={self.contract_no!r} status={self.status!r}>"   __all__ = ["Contract"])
